{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/base",
  "exclude": [
    "node_modules",
    "dist",
    "src/_components"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "astro/client",
      "node",
      "react",
      "react-dom"
    ]
  }
}
